{
    "magic": "dsg.config",
    "version": "1.0",
    "contents": {
        "edgeSide": {
            "value": "right",
            "serial": 0,
            "name": "边缘位置",
            "description": "Panel edge: left or right",
            "permissions": "readwrite",
            "visibility": "public"
        },
        "autoHide": {
            "value": true,
            "serial": 0,
            "name": "自动隐藏",
            "description": "Auto hide panel when mouse leaves",
            "permissions": "readwrite",
            "visibility": "public"
        },
        "monitorInterval": {
            "value": 2000,
            "serial": 0,
            "name": "监控刷新间隔",
            "description": "System monitor poll interval in milliseconds",
            "permissions": "readwrite",
            "visibility": "public"
        },
        "maxClipboardItems": {
            "value": 50,
            "serial": 0,
            "name": "剪贴板最大条数",
            "description": "Maximum clipboard history items",
            "permissions": "readwrite",
            "visibility": "public"
        },
        "enableClipboardImages": {
            "value": true,
            "serial": 0,
            "name": "剪贴板图片历史",
            "description": "Enable clipboard image history (screenshots, copied images)",
            "permissions": "readwrite",
            "visibility": "public"
        },
        "netSpeedUnit": {
            "value": "byte",
            "serial": 0,
            "name": "网速单位",
            "description": "Network speed unit: byte (KB/s) or bit (kbps)",
            "permissions": "readwrite",
            "visibility": "public"
        },
        "cpuAlertThreshold": {
            "value": 80,
            "serial": 0,
            "name": "CPU告警阈值",
            "description": "CPU usage percentage threshold for process alert (0=disabled)",
            "permissions": "readwrite",
            "visibility": "public"
        },
        "trafficThresholdMB": {
            "value": 0,
            "serial": 0,
            "name": "流量预警阈值",
            "description": "Daily traffic threshold in MB for alert (0=disabled)",
            "permissions": "readwrite",
            "visibility": "public"
        }
    }
}
